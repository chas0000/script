#!name = 奇瑞汽车 App 自动签到
#!desc = 自动抓取 Token 并支持通过插件设置菜单（Argument）控制签到与测试
#!author = fmz200 & Assistant
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png
#!tag = 签到, 自动任务
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.0

[Argument]
cron = input, "0 9 * * *", tag=签到执行时间, desc=Cron定时表达式，默认每天 09:00
manual_token = input, "", tag=手动指定Token(可选), desc=如果抓包未获取到，可在此处手动粘贴 Token；留空则默认读取抓包保存的 Token
notify_mode = select, "全部通知", "仅失败通知", "静默运行", tag=通知模式, desc=选择运行后的系统弹窗通知方式

[Script]
# 1. 抓包重写：打开 App 触发请求时自动解析并保存 access_token 到 PersistentStore
http-request ^https:\/\/mobile-consumer-sapp\.chery\.cn\/ code-block="const headers=$request.headers;let token='';if(headers['Authorization']\vert{}\vert{}headers['authorization']){let auth=headers['Authorization']\vert{}\vert{}headers['authorization'];token=auth.replace('Bearer ','').trim();}if(token){let oldToken=$persistentStore.read('chery_access_token');if(oldToken!==token){$persistentStore.write(token,'chery_access_token');$notification.post('奇瑞 App Token 获取成功 🎉','','Token 前缀: '+token.substring(0,8)+'... 已成功存入本地持久化存储');console.log('[奇瑞App] Token已更新');}}$done({});", requires-body=false, tag=奇瑞App-获取Token

# 2. 定时任务/手动脚本：支持读取 Argument 传入的参数
cron "{cron}" code-block="const $=new Env('奇瑞汽车App签到');const userAgent='Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0';startTasks().then(()=>$.done());async function startTasks(){let token=$argument.manual_token\vert{}\vert{}$.getdata('chery_access_token');let notifyMode=$argument.notify_mode\vert{}\vert{}'全部通知';if(!token){if(notifyMode!=='静默运行'){$.notification.post($.name,'❌ 无法签到','未获取到 Token！请打开奇瑞 App 刷新或在插件设置中手动输入 Token');}$.done();return;}let signRes=await completeSignTask(token);let isSuccess=signRes.includes('成功');if(notifyMode==='全部通知'||(notifyMode==='仅失败通知'&&!isSuccess)){$.notification.post($.name,isSuccess?'🎉 任务完成':'❌ 任务失败',signRes+'\n[Token: '+token.substring(0,6)+'...]');}$.done();}function completeSignTask(token){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=${token}`,headers:{'Content-Type':'application/json','Origin':'https://hybrid-sapp.chery.cn','User-Agent':userAgent,'Authorization':`Bearer ${token}`,'Referer':'https://hybrid-sapp.chery.cn/','Accept':'*/*'},body:JSON.stringify({eventCode:'SJ10002'})};$httpClient.post(options,function(error,response,data){if(error){resolve('签到网络请求失败');}else{try{let res=JSON.parse(data);if(res.status===200){resolve('签到成功');}else{resolve('签到失败: '+(res.message||'Token无效/已过期'));}}catch(e){resolve('响应解析错误');}}});});}function Env(name){return{name:name,getdata:(key)=>$persistentStore.read(key),notification:{post:(title,sub,msg)=>$notification.post(title,sub,msg)},done:(val={})=>$done(val)};}", tag=奇瑞App-定时签到, timeout=60, argument=[{cron},{manual_token},{notify_mode}]

[Mitm]
hostname = mobile-consumer-sapp.chery.cn
