#!name = 奇瑞汽车 App 自动签到 (强力触发版)
#!desc = 修正 http-request 匹配规则，确保抓包脚本 100% 被响应触发
#!author = chas0000
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png

[Argument]
cron = input, "0 8 * * *", tag=签到执行时间, desc=Cron 定时表达式（分 时 日 月 周），默认每天 08:00
manual_token = input, "", tag=手动输入 Token (备用), desc=若自动抓包未搜到，在此输入 Bearer Token

[Script]
# 1. 抓包脚本：匹配所有奇瑞 APP 的 Task/Sign-in 接口
http-request ^https?:\/\/.*chery\.cn\/.*script-path=https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_get_token.js, requires-body=false, tag=奇瑞App-获取Token

# 2. 手动入口 (支持在【脚本】列表中点击，便于确认 JS 能否运行)
generic then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_get_token.js") with tag="奇瑞App-手动测试抓包"

# 3. 定时签到脚本
cron ${cron} then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_checkin.js", {${manual_token}}) with tag="奇瑞App-定时签到", timeout=300

[Mitm]
hostname = *.chery.cn, hybrid-sapp.chery.cn, mobile-consumer-sapp.chery.cn
