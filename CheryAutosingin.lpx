#!name = 奇瑞汽车 App 自动签到 (新版语法)
#!desc = 使用 Loon 最新 then script(...) with 链式语法
#!author = chas0000
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png

[Argument]
manual_token = input, "", tag=手动输入Token(备用), desc=若自动抓包未搜到，在此输入 Bearer Token

[Script]
# 1. 抓包脚本 (HTTP Request)
http-request if ${url} ~= /chery\.cn/ then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_get_token.js") with tag="奇瑞App-获取Token", enable=true

# 2. 定时签到脚本 (Cron Script) - 传入插件对象参数 manual_token
cron "0 8 * * *" then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_checkin.js", {${manual_token}}) with tag="奇瑞App-定时签到", timeout=300
