/**
 * @name 奇瑞汽车 App 自动签到与社区任务 (Loon 专用版)
 * @author fmz200 (Loon 适配版)
 * @description 每日自动完成签到 + 推荐文章获取与分享
 */

const $ = new Env("奇瑞汽车App签到");

// User-Agent 配置
const userAgent = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0";

startTasks().then(() => $.done());

async function startTasks() {
  // 从 Loon 持久化存储中获取 token（支持单账号或多账号 JSON）
  let tokenData = $.getdata("chery_access_token");
  
  if (!tokenData) {
    $.notification.post($.name, "❌ 签到失败", "未设置 chery_access_token，请先在 Loon 中配置！");
    $.done();
    return;
  }

  let accounts = [];
  try {
    // 兼容直接填入普通字符串 token 或者 JSON 数组格式
    if (tokenData.trim().startsWith("[")) {
      accounts = JSON.parse(tokenData);
    } else {
      accounts = [{ displayName: "奇瑞账号", access_token: tokenData.trim() }];
    }
  } catch (e) {
    $.notification.post($.name, "❌ 配置解析失败", "chery_access_token 格式不正确");
    $.done();
    return;
  }

  let summary = [];

  for (let item of accounts) {
    let name = item.displayName || "奇瑞账号";
    let token = item.access_token;

    if (!token) continue;

    // 1. 执行签到
    let signRes = await completeSignTask(token, name);
    summary.push(signRes);

    // 2. 获取推荐文章并执行分享
    let articleIds = await getArticleList(token, name);
    if (articleIds && articleIds.length > 0) {
      for (let articleId of articleIds) {
        await shareArticle(token, name, articleId);
      }
    }
  }

  // 发送 Loon 系统弹窗通知
  $.notification.post($.name, "每日任务完成", summary.join("\n"));
  $.done();
}

// 签到请求 (POST)
function completeSignTask(token, username) {
  return new Promise((resolve) => {
    const options = {
      url: `https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=${token}`,
      headers: {
        "Content-Type": "application/json",
        "Origin": "https://hybrid-sapp.chery.cn",
        "User-Agent": userAgent,
        "Authorization": `Bearer ${token}`,
        "Referer": "https://hybrid-sapp.chery.cn/",
        "Accept": "*/*"
      },
      body: JSON.stringify({ eventCode: "SJ10002" })
    };

    $httpClient.post(options, function (error, response, data) {
      if (error) {
        console.log(`[${username}] 签到请求错误: ${error}`);
        resolve(`[${username}] 签到请求异常`);
      } else {
        try {
          let res = JSON.parse(data);
          if (res.status === 200) {
            console.log(`[${username}] 签到成功`);
            resolve(`[${username}] 签到成功 🎉`);
          } else {
            console.log(`[${username}] 签到失败: ${res.message}`);
            resolve(`[${username}] 签到失败: ${res.message || "未知原因"}`);
          }
        } catch (e) {
          console.log(`[${username}] 解析响应 JSON 失败`);
          resolve(`[${username}] 响应解析异常`);
        }
      }
    });
  });
}

// 获取文章列表 (POST)
function getArticleList(token, username) {
  return new Promise((resolve) => {
    const options = {
      url: `https://mobile-consumer-sapp.chery.cn/web/community/recommend/contents?pageNo=1&pageSize=10&access_token=${token}&terminal=3`,
      headers: {
        "User-Agent": userAgent,
        "Accept": "application/json, text/plain, */*",
        "Content-Type": "application/json; charset=UTF-8",
        "Agent": "android",
        "Request-Channel": "app"
      },
      body: ""
    };

    $httpClient.post(options, function (error, response, data) {
      if (error) {
        console.log(`[${username}] 获取文章发生异常: ${error}`);
        resolve([]);
      } else {
        try {
          let res = JSON.parse(data);
          if (res.status === 200 && res.data && res.data.data && res.data.data.length >= 2) {
            let id1 = res.data.data[0].content.id;
            let id2 = res.data.data[1].content.id;
            console.log(`[${username}] 成功获取文章 ID: ${id1}, ${id2}`);
            resolve([id1, id2]);
          } else {
            console.log(`[${username}] 获取文章失败: ${res.message}`);
            resolve([]);
          }
        } catch (e) {
          console.log(`[${username}] 解析文章列表失败`);
          resolve([]);
        }
      }
    });
  });
}

// 分享文章 (POST)
function shareArticle(token, username, articleId) {
  return new Promise((resolve) => {
    const options = {
      url: `https://mobile-consumer-sapp.chery.cn/web/community/contents/${articleId}/share?access_token=${token}&terminal=3`,
      headers: {
        "User-Agent": userAgent,
        "Accept": "application/json, text/plain, */*",
        "Content-Type": "application/json; charset=UTF-8",
        "Agent": "android",
        "Request-Channel": "app"
      },
      body: JSON.stringify({ contentId: articleId })
    };

    $httpClient.post(options, function (error, response, data) {
      if (error) {
        console.log(`[${username}] 分享文章异常: ${error}`);
      } else {
        try {
          let res = JSON.parse(data);
          if (res.status === 200) {
            console.log(`[${username}] 分享文章 [${articleId}] 成功 🎉`);
          } else {
            console.log(`[${username}] 分享文章 [${articleId}] 失败: ${res.message}`);
          }
        } catch (e) {
          console.log(`[${username}] 解析分享响应失败`);
        }
      }
      resolve();
    });
  });
}

// Loon 环境轻量封装对象
function Env(name) {
  return {
    name: name,
    getdata: (key) => $persistentStore.read(key),
    setdata: (val, key) => $persistentStore.write(val, key),
    notification: {
      post: (title, sub, msg) => $notification.post(title, sub, msg)
    },
    done: (val = {}) => $done(val)
  };
}