#!name = 奇瑞汽车 App 自动签到 (GitHub 双脚本版)
#!desc = 引用 GitHub 远程 JS 文件，支持自动抓包与定时自动签到
#!author = fmz200 & Assistant
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png
#!tag = 签到, 自动任务
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.0

[Argument]
cron = input, "0 9 * * *", tag=签到执行时间, desc=Cron定时表达式，默认每天 09:00
manual_token = input, "", tag=手动输入Token(备用), desc=若自动抓包未搜到，在此输入 Bearer Token（不带 Bearer 前缀）

[Script]
# 1. 抓包脚本：捕获 Token 并保存到 PersistentStore
http-request ^https?:\/\/.*chery\.cn\/ script-path=https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_get_token.js, requires-body=false, tag=奇瑞App-获取Token

# 2. 定时签到脚本：读取 Token 执行每日签到
cron "{cron}" script-path=https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_checkin.js, tag=奇瑞App-定时签到, timeout=60, argument=[{manual_token}]

[Mitm]
hostname = *.chery.cn, hybrid-sapp.chery.cn, mobile-consumer-sapp.chery.cn
