#!name = 奇瑞汽车 App 自动签到
#!desc = 自动抓取并保存 Token，带有完整的 Token 状态检测、运行日志输出与系统通知
#!author = fmz200 & Assistant
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png
#!tag = 签到, 自动任务
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.0

[Argument]
cron = input, "0 9 * * *", tag=签到执行时间, desc=Cron定时表达式，默认每天 09:00

[Script]
# 1. 自动抓包重写：打开 App 时拦截并更新 Token，触发通知与控制台日志
http-request ^https:\/\/mobile-consumer-sapp\.chery\.cn\/ code-block="const headers = $request.headers; let token = ''; if (headers['Authorization'] || headers['authorization']) { let auth = headers['Authorization'] || headers['authorization']; token = auth.replace('Bearer ', '').trim(); } if (token) { let oldToken = $persistentStore.read('chery_access_token'); if (oldToken !== token) { $persistentStore.write(token, 'chery_access_token'); console.log('[奇瑞App] 🔑 成功抓取并保存新 Token: ' + token); $notification.post('奇瑞 App', '🎉 Token 获取/更新成功', 'Token (' + token.substring(0, 8) + '...) 已保存至本地持久化存储！'); } else { console.log('[奇瑞App] ℹ️️ 检测到相同 Token，无需重复更新'); } } $done({});", requires-body=false, tag=奇瑞App-获取Token

# 2. 定时签到脚本：自动读取 Token 状态，发起签到并输出日志与通知
cron "{cron}" code-block="const logPrefix = '[奇瑞App签到]'; let token = $persistentStore.read('chery_access_token'); console.log(logPrefix + ' 开始检查 Token 存储状态...'); if (!token) { console.log(logPrefix + ' ❌ 错误：本地 PersistentStore 未检索到 chery_access_token！'); $notification.post('奇瑞 App 签到', '❌ 签到中断 (缺少 Token)', '未检测到保存的 Token，请先打开奇瑞 App 刷新激活抓包！'); $done(); } else { console.log(logPrefix + ' ✅ 已找到保存的 Token: ' + token.substring(0, 8) + '...'); $notification.post('奇瑞 App 签到', 'ℹ️ 开始执行每日任务', '已检测到有效 Token，正在发起签到请求...'); const userAgent = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0'; const options = { url: 'https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=' + token, headers: { 'Content-Type': 'application/json', 'Origin': 'https://hybrid-sapp.chery.cn', 'User-Agent': userAgent, 'Authorization': 'Bearer ' + token, 'Referer': 'https://hybrid-sapp.chery.cn/', 'Accept': '*/*' }, body: JSON.stringify({ eventCode: 'SJ10002' }) }; $httpClient.post(options, function (error, response, data) { if (error) { console.log(logPrefix + ' ❌ 网络请求失败: ' + JSON.stringify(error)); $notification.post('奇瑞 App 签到', '❌ 网络请求异常', error); } else { try { console.log(logPrefix + ' 📥 接口响应原文: ' + data); let res = JSON.parse(data); if (res.status === 200) { console.log(logPrefix + ' 🎉 签到成功！'); $notification.post('奇瑞 App 签到', '🎉 签到成功', '每日签到任务已顺利完成！'); } else { console.log(logPrefix + ' ⚠️ 签到失败: ' + (res.message || '未知错误')); $notification.post('奇瑞 App 签到', '⚠️ 签到失败', res.message || 'Token 可能已失效，请打开 App 重新抓取'); } } catch (e) { console.log(logPrefix + ' ❌ 响应 JSON 解析异常: ' + e); $notification.post('奇瑞 App 签到', '❌ 解析失败', '返回数据格式不匹配'); } } $done(); }); }", tag=奇瑞App-定时签到, timeout=60

[Mitm]
hostname = mobile-consumer-sapp.chery.cn
