#!name = 奇瑞汽车 App 自动签到 (双脚本显示版)
#!desc = 支持自动抓包与手动查看/测试
#!author = chas0000
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png

[Argument]
cron = input, "0 8 * * *", tag=签到执行时间, desc=Cron 定时表达式（分 时 日 月 周），默认每天 08:00
manual_token = input, "", tag=手动输入 Token (备用), desc=若自动抓包未搜到，在此输入 Bearer Token

[Script]
# 1. 后台静默抓包 (HTTP 被动触发)
http-request if ${url} ~= /chery\.cn/ then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_get_token.js") with tag="奇瑞App-获取Token(自动)", enable=true

# 2. 详情页可显示的手动/测试入口 (Generic 脚本)
generic then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_get_token.js") with tag="奇瑞App-获取Token(手动/测试)"

# 3. 定时签到脚本
cron ${cron} then script("https://raw.githubusercontent.com/chas0000/script/refs/heads/main/chery_checkin.js", {${manual_token}}) with tag="奇瑞App-定时签到", timeout=300

[Mitm]
hostname = *.chery.cn, hybrid-sapp.chery.cn, mobile-consumer-sapp.chery.cn
