#!name = 奇瑞汽车 App 自动签到
#!desc = 自动抓取 Token 并每天定时完成签到与社区分享任务（纯内嵌免外链，带手动测试面板）
#!author = fmz200 & Assistant
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png
#!tag = 签到, 自动任务
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.0

[Argument]
cron = input, "0 9 * * *", tag=签到执行时间, desc=Cron定时表达式，默认每天 09:00

[Panel]
# 手动测试面板：点击面板右上角的刷新按钮即可立即触发运行
奇瑞签到测试 = code-block="const $=new Env('奇瑞汽车App签到');const userAgent='Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0';startTasks().then(()=>$.done());async function startTasks(){let token=$.getdata('chery_access_token');if(!token){$.notification.post($.name,'❌ 签到失败','尚未获取 Token，请打开奇瑞 App 刷新一次！');$.done({title:'奇瑞签到',content:'❌ 缺少Token'});return;}let username='奇瑞账号';let signRes=await completeSignTask(token,username);let articleIds=await getArticleList(token,username);if(articleIds&&articleIds.length>0){for(let articleId of articleIds){await shareArticle(token,username,articleId);}}$.notification.post($.name,'每日任务完成',signRes);$.done({title:'奇瑞签到',content:signRes});}function completeSignTask(token,username){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=${token}`,headers:{'Content-Type':'application/json','Origin':'https://hybrid-sapp.chery.cn','User-Agent':userAgent,'Authorization':`Bearer ${token}`,'Referer':'https://hybrid-sapp.chery.cn/','Accept':'*/*'},body:JSON.stringify({eventCode:'SJ10002'})};$httpClient.post(options,function(error,response,data){if(error){resolve(`[${username}] 签到请求异常`);}else{try{let res=JSON.parse(data);if(res.status===200){resolve(`[${username}] 签到成功 🎉`);}else{resolve(`[${username}] 签到失败: ${res.message||'Token可能失效'}`);}}catch(e){resolve(`[${username}] 响应解析异常`);}}});});}function getArticleList(token,username){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/community/recommend/contents?pageNo=1&pageSize=10&access_token=${token}&terminal=3`,headers:{'User-Agent':userAgent,'Accept':'application/json, text/plain, */*','Content-Type':'application/json; charset=UTF-8','Agent':'android','Request-Channel':'app'},body:''};$httpClient.post(options,function(error,response,data){if(error){resolve([]);}else{try{let res=JSON.parse(data);if(res.status===200&&res.data&&res.data.data&&res.data.data.length>=2){resolve([res.data.data[0].content.id,res.data.data[1].content.id]);}else{resolve([]);}}catch(e){resolve([]);}}});});}function shareArticle(token,username,articleId){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/community/contents/${articleId}/share?access_token=${token}&terminal=3`,headers:{'User-Agent':userAgent,'Accept':'application/json, text/plain, */*','Content-Type':'application/json; charset=UTF-8','Agent':'android','Request-Channel':'app'},body:JSON.stringify({contentId:articleId})};$httpClient.post(options,function(error,response,data){resolve();});});}function Env(name){return{name:name,getdata:(key)=>$persistentStore.read(key),setdata:(val,key)=>$persistentStore.write(val,key),notification:{post:(title,sub,msg)=>$notification.post(title,sub,msg)},done:(val={})=>$done(val)};}", icon=https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png, title="奇瑞签到测试", content="点击右上角刷新按钮手动测试签到", update-interval=86400

[Script]
# 1. 抓包重写：打开 App 时拦截 Authorization 提取 token 保存在本地
http-request ^https:\/\/mobile-consumer-sapp\.chery\.cn\/ code-block="const headers=$request.headers;let token='';if(headers['Authorization']\vert{}\vert{}headers['authorization']){let auth=headers['Authorization']\vert{}\vert{}headers['authorization'];token=auth.replace('Bearer ','').trim();}if(token){let oldToken=$persistentStore.read('chery_access_token');if(oldToken!==token){$persistentStore.write(token,'chery_access_token');$notification.post('奇瑞 App Token 获取成功 🎉','','Token 已自动更新保存，可离线自动签到！');}}$done();", requires-body=false, tag=奇瑞App-获取Token

# 2. 定时任务：根据 [Argument] 配置的 Cron 时间触发自动签到
cron "{cron}" code-block="const $=new Env('奇瑞汽车App签到');const userAgent='Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0';startTasks().then(()=>$.done());async function startTasks(){let token=$.getdata('chery_access_token');if(!token){$.notification.post($.name,'❌ 签到失败','尚未获取 Token，请打开奇瑞 App 刷新一次！');$.done();return;}let username='奇瑞账号';let signRes=await completeSignTask(token,username);let articleIds=await getArticleList(token,username);if(articleIds&&articleIds.length>0){for(let articleId of articleIds){await shareArticle(token,username,articleId);}}$.notification.post($.name,'每日任务完成',signRes);$.done();}function completeSignTask(token,username){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=${token}`,headers:{'Content-Type':'application/json','Origin':'https://hybrid-sapp.chery.cn','User-Agent':userAgent,'Authorization':`Bearer ${token}`,'Referer':'https://hybrid-sapp.chery.cn/','Accept':'*/*'},body:JSON.stringify({eventCode:'SJ10002'})};$httpClient.post(options,function(error,response,data){if(error){resolve(`[${username}] 签到请求异常`);}else{try{let res=JSON.parse(data);if(res.status===200){resolve(`[${username}] 签到成功 🎉`);}else{resolve(`[${username}] 签到失败: ${res.message||'Token可能失效'}`);}}catch(e){resolve(`[${username}] 响应解析异常`);}}});});}function getArticleList(token,username){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/community/recommend/contents?pageNo=1&pageSize=10&access_token=${token}&terminal=3`,headers:{'User-Agent':userAgent,'Accept':'application/json, text/plain, */*','Content-Type':'application/json; charset=UTF-8','Agent':'android','Request-Channel':'app'},body:''};$httpClient.post(options,function(error,response,data){if(error){resolve([]);}else{try{let res=JSON.parse(data);if(res.status===200&&res.data&&res.data.data&&res.data.data.length>=2){resolve([res.data.data[0].content.id,res.data.data[1].content.id]);}else{resolve([]);}}catch(e){resolve([]);}}});});}function shareArticle(token,username,articleId){return new Promise((resolve)=>{const options={url:`https://mobile-consumer-sapp.chery.cn/web/community/contents/${articleId}/share?access_token=${token}&terminal=3`,headers:{'User-Agent':userAgent,'Accept':'application/json, text/plain, */*','Content-Type':'application/json; charset=UTF-8','Agent':'android','Request-Channel':'app'},body:JSON.stringify({contentId:articleId})};$httpClient.post(options,function(error,response,data){resolve();});});}function Env(name){return{name:name,getdata:(key)=>$persistentStore.read(key),setdata:(val,key)=>$persistentStore.write(val,key),notification:{post:(title,sub,msg)=>$notification.post(title,sub,msg)},done:(val={})=>$done(val)};}", tag=奇瑞App-定时签到, timeout=60

[Mitm]
hostname = mobile-consumer-sapp.chery.cn
