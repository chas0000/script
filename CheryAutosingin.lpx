#!name = 奇瑞签到通知测试
#!desc = 用于测试通知权限与 Token 读取
#!author = fmz200 & Assistant
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png
#!tag = 签到, 自动任务
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.0

[Argument]
manual_token = input, "", tag=手动Token(测试用), desc=若无 Token 可在此手动填写

[Script]
# 1. 抓包测试
http-request ^https?:\/\/.*chery\.cn\/ code-block="console.log('[测试] 抓包被触发了'); $notification.post('奇瑞抓包', '🔔 抓包成功', '拦截到请求: ' + $request.url); $done({});", requires-body=false, tag=奇瑞App-抓包测试

# 2. 手动运行签到测试
cron "0 9 * * *" code-block="const logPrefix = '[奇瑞App签到]'; console.log(logPrefix + ' 手动执行签到逻辑...'); let token = $persistentStore.read('chery_access_token') || $argument.manual_token; if (!token) { $notification.post('奇瑞 App 签到', '❌ 未找到 Token', '请先打开 App 抓取或在插件参数中手动填入'); $done(); } else { $notification.post('奇瑞 App 签到', 'ℹ️ 正在发送请求', 'Token: ' + token.substring(0, 6) + '...'); const userAgent = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0'; const options = { url: 'https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=' + token, headers: { 'Content-Type': 'application/json', 'Origin': 'https://hybrid-sapp.chery.cn', 'User-Agent': userAgent, 'Authorization': 'Bearer ' + token, 'Referer': 'https://hybrid-sapp.chery.cn/' }, body: JSON.stringify({ eventCode: 'SJ10002' }) }; $httpClient.post(options, function (error, response, data) { if (error) { $notification.post('奇瑞 App 签到', '❌ 请求失败', JSON.stringify(error)); } else { $notification.post('奇瑞 App 签到', '📥 收到响应', data); } $done(); }); }", tag=奇瑞App-手动测试, timeout=60, argument=[{manual_token}]

[Mitm]
hostname = *.chery.cn, hybrid-sapp.chery.cn, mobile-consumer-sapp.chery.cn
