#!name = 奇瑞汽车 App 自动签到
#!desc = 自动抓取 Token，提供首页 Panel 显示 Token 状态与一键手动测试签到
#!author = fmz200 & Assistant
#!icon = https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png
#!tag = 签到, 自动任务
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.0

[Argument]
cron = input, "0 9 * * *", tag=签到执行时间, desc=Cron定时表达式，默认每天 09:00

[Panel]
# 首页面板：会实时显示当前 Token 状态，点击右上角刷新按钮可立即测试签到
奇瑞汽车签到 = code-block="const token = $persistentStore.read('chery_access_token'); if (!token) { $done({title: '奇瑞汽车 App 签到', content: '❌ 未获取 Token (请打开 App 刷新)', icon: 'exclamationmark.triangle.fill'}); } else { const maskingToken = token.substring(0, 6) + '...' + token.substring(token.length - 4); startTasks(token); } async function startTasks(token) { const userAgent = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0'; const options = { url: 'https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=' + token, headers: { 'Content-Type': 'application/json', 'Origin': 'https://hybrid-sapp.chery.cn', 'User-Agent': userAgent, 'Authorization': 'Bearer ' + token, 'Referer': 'https://hybrid-sapp.chery.cn/', 'Accept': '*/*' }, body: JSON.stringify({ eventCode: 'SJ10002' }) }; $httpClient.post(options, function (error, response, data) { if (error) { $done({title: '奇瑞汽车 App 签到', content: '❌ 请求失败: ' + error, icon: 'xmark.circle.fill'}); } else { try { let res = JSON.parse(data); if (res.status === 200) { $done({title: '奇瑞汽车 App 签到', content: '🎉 签到成功 | Token: ' + token.substring(0,6)+'...', icon: 'checkmark.circle.fill'}); } else { $done({title: '奇瑞汽车 App 签到', content: '⚠️ ' + (res.message || 'Token失效'), icon: 'exclamationmark.circle.fill'}); } } catch (e) { $done({title: '奇瑞汽车 App 签到', content: '❌ 解析响应失败', icon: 'xmark.circle.fill'}); } } }); }", icon=https://raw.githubusercontent.com/kwmet/Loon-Gallery/main/icon/chery.png, title="奇瑞汽车 App 签到", content="正在检测 Token 状态...", update-interval=3600

[Script]
# 1. 抓包重写：打开奇瑞 App 时自动提取 Authorization 并在应用内弹出 Notification 提示
http-request ^https:\/\/mobile-consumer-sapp\.chery\.cn\/ code-block="const headers = $request.headers; let token = ''; if (headers['Authorization'] || headers['authorization']) { let auth = headers['Authorization'] || headers['authorization']; token = auth.replace('Bearer ', '').trim(); } if (token) { let oldToken = $persistentStore.read('chery_access_token'); if (oldToken !== token) { $persistentStore.write(token, 'chery_access_token'); $notification.post('奇瑞 App Token 获取成功 🎉', '', 'Token: ' + token.substring(0,8) + '... 已存入本地PersistentStore'); console.log('[奇瑞App] Token更新成功: ' + token); } } $done({});", requires-body=false, tag=奇瑞App-获取Token

# 2. 定时任务：每日定时签到
cron "{cron}" code-block="const token = $persistentStore.read('chery_access_token'); if (!token) { $notification.post('奇瑞App签到', '❌ 签到失败', '未找到本地 Token，请打开 App 刷新'); $done(); } else { const userAgent = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 ios/1.0.0'; const options = { url: 'https://mobile-consumer-sapp.chery.cn/web/event/trigger?access_token=' + token, headers: { 'Content-Type': 'application/json', 'Origin': 'https://hybrid-sapp.chery.cn', 'User-Agent': userAgent, 'Authorization': 'Bearer ' + token, 'Referer': 'https://hybrid-sapp.chery.cn/', 'Accept': '*/*' }, body: JSON.stringify({ eventCode: 'SJ10002' }) }; $httpClient.post(options, function (error, response, data) { try { let res = JSON.parse(data); if (res.status === 200) { $notification.post('奇瑞App签到', '🎉 签到成功', '每日自动签到已完成'); } else { $notification.post('奇瑞App签到', '❌ 签到失败', res.message || 'Token可能已失效'); } } catch(e) { $notification.post('奇瑞App签到', '❌ 异常', '返回数据格式错误'); } $done(); }); }", tag=奇瑞App-定时签到, timeout=60

[Mitm]
hostname = mobile-consumer-sapp.chery.cn
